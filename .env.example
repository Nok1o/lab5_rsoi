# Exact Auth0 issuer, including its trailing slash. No tokens go into this file.
OIDC_ISSUER=https://YOUR_TENANT.eu.auth0.com/
OIDC_AUDIENCE=https://library-system
OIDC_INTERNAL_AUDIENCE=https://library-system/internal

# Gateway only: Machine-to-Machine application for the internal API.
OIDC_WORKER_CLIENT_ID=replace-with-worker-client-id
OIDC_WORKER_CLIENT_SECRET=replace-with-worker-client-secret
